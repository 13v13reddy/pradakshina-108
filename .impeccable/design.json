ead\" cx=\"28.121\" cy=\"129.673\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"31.304\" cy=\"120.927\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"34.991\" cy=\"112.381\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"39.168\" cy=\"104.064\" r=\"3\"/><circle class=\"ds-bead\" cx=\"43.821\" cy=\"96.004\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"48.936\" cy=\"88.228\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"54.493\" cy=\"80.762\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"60.476\" cy=\"73.633\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"66.863\" cy=\"66.863\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"73.633\" cy=\"60.476\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"80.762\" cy=\"54.493\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"88.228\" cy=\"48.936\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"96.004\" cy=\"43.821\" r=\"3\"/><circle class=\"ds-bead\" cx=\"104.064\" cy=\"39.168\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"112.381\" cy=\"34.991\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"120.927\" cy=\"31.304\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"129.673\" cy=\"28.121\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"138.589\" cy=\"25.452\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"147.645\" cy=\"23.306\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"156.811\" cy=\"21.689\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"166.055\" cy=\"20.609\" r=\"2.3\"/><circle class=\"ds-bead\" cx=\"175.346\" cy=\"20.068\" r=\"3\"/></g><path class=\"ds-marker\" d=\"m180 4 4 6-4 6-4-6z\"/></svg><div class=\"ds-circle-copy\"><span class=\"ds-count-label\">ROUNDS COMPLETED</span><span class=\"ds-count\">1</span><span class=\"ds-goal\">of 108 pradakshinas</span><span class=\"ds-walking\">You’re on round 2</span></div></div>",
      "css": ".ds-circle{position:relative;width:min(100%,340px);aspect-ratio:1;color:var(--jasmine,#f6f3e8);font-family:DM,sans-serif}.ds-bead-circle{display:block;width:100%;height:100%;overflow:visible}.ds-inner-orbit{stroke:var(--line,#3e6054);stroke-width:.6;fill:none}.ds-marker{fill:var(--brass,#e0bd7f)}.ds-bead{fill:#6b8978;opacity:.7;transition:fill 250ms ease,opacity 250ms ease}.ds-bead:nth-child(9n){opacity:1}.ds-completed{fill:var(--brass,#e0bd7f);opacity:1}.ds-current{fill:var(--jasmine,#f6f3e8);opacity:1}.ds-circle-copy{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;pointer-events:none}.ds-count-label{font-size:11px;letter-spacing:.12em;color:var(--sage,#b8cbbd);font-weight:600;margin-top:14px}.ds-count{font:400 112px/.95 Instrument,Georgia,serif;letter-spacing:-.035em;font-variant-numeric:lining-nums tabular-nums;margin:13px 0 12px}.ds-goal{font-size:12px;color:var(--sage,#b8cbbd)}.ds-walking{font-size:12px;color:var(--brass,#e0bd7f);margin-top:23px}@media(prefers-reduced-motion:reduce){.ds-bead{transition:none}}"
    },
    {
      "name": "Jasmine sheet",
      "kind": "custom",
      "refersTo": "sheet",
      "description": "The light secondary layer for history, preferences, and installation; actual use is a native modal dialog.",
      "html": "<section class=\"ds-sheet\" role=\"dialog\" aria-label=\"Preferences preview\"><div class=\"ds-sheet-header\"><h2>Make yourself comfortable.</h2><button class=\"ds-sheet-close\" type=\"button\" aria-label=\"Close settings\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button></div><p class=\"ds-sheet-description\">A few small things, for your practice.</p></section>",
      "css": ".ds-sheet{color-scheme:light;color:var(--ink,#173d34);background:var(--jasmine,#f6f3e8);border:0;border-radius:18px;padding:30px;width:min(460px,calc(100% - 32px));max-height:min(80svh,760px);overflow:auto;box-shadow:0 16px 72px #071f1966;font-family:DM,sans-serif;overscroll-behavior:contain}.ds-sheet-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.ds-sheet h2{font:400 34px/1.07 Instrument,Georgia,serif;margin:3px 0 0;letter-spacing:-.02em;text-wrap:balance}.ds-sheet-close{border:0;background:none;display:inline-flex;align-items:center;justify-content:center;min-height:44px;width:44px;flex-shrink:0;color:var(--ink,#173d34);padding:8px 4px;margin:-8px -12px 0 0;cursor:pointer}.ds-sheet-close:focus-visible{outline:2px solid var(--ink,#173d34);outline-offset:3px}.ds-sheet-close .ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;}.ds-sheet-description{font-size:12px;color:#4c6556;line-height:1.6;margin:13px 0 24px}@media(max-width:760px){.ds-sheet{padding:25px 23px;max-height:85svh;border-radius:18px 18px 0 0;width:100%;max-width:480px;padding-bottom:max(25px,env(safe-area-inset-bottom));box-shadow:0 -10px 55px #071f1940}.ds-sheet h2{font-size:32px}}"
    },
    {
      "name": "Saved round row",
      "kind": "custom",
      "refersTo": "history-row",
      "description": "A quiet chronological row inside a jasmine history sheet, with aligned time and date.",
      "html": "<ol class=\"ds-history\"><li class=\"ds-history-row\"><span class=\"ds-history-dot\" aria-hidden=\"true\"></span><span class=\"ds-history-round\">Round 1</span><time class=\"ds-history-time\" datetime=\"2026-10-20T17:27:26-05:00\">5:27:26 PM<span class=\"ds-history-date\">Oct 20</span></time></li></ol>",
      "css": ".ds-history{list-style:none;margin:0;padding:0;font-family:DM,sans-serif;color:var(--ink,#173d34);font-variant-numeric:tabular-nums}.ds-history-row{display:flex;align-items:center;gap:13px;padding:15px 0;border-top:1px solid #d6dcd0}.ds-history-dot{width:7px;height:7px;border-radius:50%;background:#a78348;flex:none}.ds-history-round{font-size:12px;font-weight:600;flex:1}.ds-history-time{font-size:11px;text-align:right;color:#4c6556}.ds-history-date{font-size:11px;display:block;margin-top:4px}"
    }
  ],
  "narrative": {
    "northStar": "The Temple Pond",
    "overview": "A temple pond at rest: one continuous green field, pale jasmine type, sage supporting detail, and brass that marks attention. The interface is quiet and spacious, with a serif voice that feels human and a clear sans serif that keeps actions and saved evidence easy to scan.\n\nThe world is expressed through working geometry and restrained material changes. Circular marks carry actual progress; the latest saved round keeps its timestamp after feedback ends. The practice field stays open, while light sheets bring secondary tasks into a separate, readable layer. Local fonts and functional SVG carry the identity without raster illustration.",
    "keyCharacteristics": [
      "An open pond-green field with a single brass primary action.",
      "Instrument Serif for expression and count; DM Sans for operation and evidence.",
      "Circular, data-bearing geometry with quiet hairline dividers.",
      "Persistent receipts and brief, state-led motion."
    ],
    "rules": [
      {
        "name": "The Attention Rule",
        "body": "Use brass for the deliberate primary action, completed progress, and small orientation or confirmation details. Use jasmine for primary reading and sage for supporting reading.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Let the serif carry the heading, count, and sheet titles. Keep actions, instructions, timestamps, and state explanations in DM Sans.",
        "section": "typography"
      },
      {
        "name": "The Quiet Field Rule",
        "body": "Keep the main practice surface flat. Reserve ambient elevation for sheets that interrupt it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the open green practice field and the restrained brass, jasmine, and sage roles.",
      "Do use the serif for expressive text and the count, with DM Sans for actions and timestamps.",
      "Do show a lasting saved receipt, including exact time and relative age, after a successful record.",
      "Do keep controls at least 44px in their interactive dimension and respect iPhone safe areas.",
      "Do preserve keyboard access, visible focus, native dialog behavior, the tap alternative, and reduced-motion support.",
      "Do make every bead correspond to a real completed or pending round."
    ],
    "donts": [
      "Don't place the primary practice content inside nested decorative cards.",
      "Don't replace the timestamped receipt with transient animation or haptic feedback alone.",
      "Don't use decorative geometry in place of the functional 108-mark progress sequence.",
      "Don't add sound, looping ambient animation, or celebratory motion to this quiet practice world.",
      "Don't present the app as detecting physical movement or completing rounds automatically."
    ]
  }
}
