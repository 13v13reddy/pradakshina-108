  "components": [
    {
      "name": "Hold to record",
      "kind": "button",
      "refersTo": "record-ready",
      "description": "The deliberate primary action. Real input commits after 850ms; guard and completion use separate state surfaces.",
      "html": "<button class=\"ds-record\" type=\"button\"><span class=\"ds-hold-fill\" aria-hidden=\"true\"></span><span class=\"ds-record-symbol\" aria-hidden=\"true\"><span class=\"ds-press-ring\"></span></span><span class=\"ds-record-copy\"><span class=\"ds-record-title\">Hold to complete a round</span><span class=\"ds-record-subtitle\">A steady touch. We’ll take it from here.</span></span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></button>",
      "css": ".ds-record{position:relative;overflow:hidden;isolation:isolate;width:100%;min-height:82px;display:flex;align-items:center;gap:15px;text-align:left;border:0;border-radius:14px;background:var(--brass,#e0bd7f);color:var(--ink,#173d34);padding:18px 20px;font-family:DM,sans-serif;cursor:pointer;transition:background 180ms ease}.ds-record:hover:not(:disabled){background:#ebca92}.ds-record:focus-visible{outline:2px solid var(--jasmine,#f6f3e8);outline-offset:5px}.ds-record[data-mode=guard]{background:#bfd0b9}.ds-record[data-mode=paused],.ds-record[data-mode=blocked]{background:#37584b;color:var(--jasmine,#f6f3e8)}.ds-record[data-mode=complete]{background:var(--jasmine,#f6f3e8)}.ds-hold-fill{position:absolute;inset:0;z-index:-1;background:#f6e3bc;transform:scaleX(0);transform-origin:left}.ds-record-symbol{width:37px;height:37px;display:flex;align-items:center;justify-content:center;border:1px solid #607157;border-radius:50%;flex:none}.ds-press-ring{width:13px;height:13px;border:1.5px solid currentColor;border-radius:50%;position:relative}.ds-press-ring:after{content:\"\";position:absolute;inset:3px;border:1px solid currentColor;border-radius:50%}.ds-record-copy{display:flex;flex-direction:column;gap:5px;flex:1}.ds-record-title{font-size:14px;font-weight:600;line-height:1.3}.ds-record-subtitle{font-size:11px;color:#3f5842;line-height:1.4}.ds-record[data-mode=paused] .ds-record-subtitle,.ds-record[data-mode=blocked] .ds-record-subtitle{color:var(--sage,#b8cbbd)}.ds-record .ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;opacity:.65}.ds-record.is-holding .ds-record-symbol{background:var(--ink,#173d34);color:var(--brass,#e0bd7f);border-color:var(--ink,#173d34)}@media(prefers-reduced-motion:reduce){.ds-record{transition:none}}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "A secondary action on the open green practice field.",
      "html": "<button class=\"ds-quiet\" type=\"button\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14m8-14v14\"/></svg><span>Pause</span></button>",
      "css": ".ds-quiet{border:0;background:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;color:var(--sage,#b8cbbd);padding:8px 4px;font:400 12px DM,sans-serif;cursor:pointer;transition:color 160ms ease}.ds-quiet:hover{color:var(--jasmine,#f6f3e8)}.ds-quiet:focus-visible{outline:2px solid var(--brass,#e0bd7f);outline-offset:5px}.ds-quiet:disabled{opacity:.4;cursor:default}.ds-quiet .ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}"
    },
    {
      "name": "Solid sheet action",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "A compact affirmative control inside a jasmine sheet.",
      "html": "<button class=\"ds-solid\" type=\"button\">Undo round</button>",
      "css": ".ds-solid{font:600 12px DM,sans-serif;border-radius:9px;border:0;min-height:44px;padding:12px 18px;background:var(--green,#153e35);color:var(--jasmine,#f6f3e8);cursor:pointer}.ds-solid:focus-visible{outline:2px solid var(--ink,#173d34);outline-offset:3px}"
    },
    {
      "name": "Keep or cancel action",
      "kind": "button",
      "refersTo": "button-subtle",
      "description": "A quiet companion to the affirmative confirmation action.",
      "html": "<button class=\"ds-subtle\" type=\"button\">Keep my place</button>",
      "css": ".ds-subtle{font:600 12px DM,sans-serif;border-radius:9px;border:0;min-height:44px;padding:12px 18px;background:#e3e6da;color:var(--ink,#173d34);cursor:pointer}.ds-subtle:focus-visible{outline:2px solid var(--ink,#173d34);outline-offset:3px}"
    },
    {
      "name": "Practice tools",
      "kind": "nav",
      "refersTo": "navigation-tools",
      "description": "History and preferences remain standard labeled buttons with restrained inline SVG.",
      "html": "<nav class=\"ds-tools\" aria-label=\"Practice tools\"><button class=\"ds-tool\" type=\"button\" aria-haspopup=\"dialog\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5m4-1v5l4 2\"/></svg><span>Your rounds</span></button><button class=\"ds-tool ds-tool-icon\" type=\"button\" aria-label=\"Open settings\" aria-haspopup=\"dialog\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6\"/></svg></button></nav>",
      "css": ".ds-tools{display:flex;align-items:center;gap:21px}.ds-tool{border:0;background:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;color:var(--sage,#b8cbbd);padding:8px 4px;font:400 12px DM,sans-serif;cursor:pointer;transition:color 160ms ease}.ds-tool:hover{color:var(--jasmine,#f6f3e8)}.ds-tool:focus-visible{outline:2px solid var(--brass,#e0bd7f);outline-offset:5px}.ds-tool-icon{width:44px;flex-shrink:0}.ds-tool .ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;}@media(max-width:760px){.ds-tools{gap:9px}.ds-tool{font-size:11px;gap:6px}.ds-tool .ds-icon{width:17px;height:17px}}@media(max-width:340px){.ds-tool{width:44px}.ds-tool span{display:none}}@media(prefers-reduced-motion:reduce){.ds-tool{transition:none}}"
    },
    {
      "name": "Preference switch",
      "kind": "input",
      "refersTo": "switch-off",
      "description": "A native button with switch semantics, a 44px target, and explicit checked/disabled states.",
      "html": "<button class=\"ds-switch\" type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"Tap instead of hold\"><span></span></button>",
      "css": ".ds-switch{width:44px;min-width:44px;height:44px;border:0;padding:10px 0;background:none;position:relative;cursor:pointer}.ds-switch:before{content:\"\";position:absolute;inset:10px 0;border-radius:20px;background:#aab8a9;transition:background 180ms ease}.ds-switch span{position:absolute;top:13px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--jasmine,#f6f3e8);transition:transform 180ms cubic-bezier(.16,1,.3,1)}.ds-switch[aria-checked=true]:before{background:var(--green,#153e35)}.ds-switch[aria-checked=true] span{transform:translateX(20px)}.ds-switch:focus-visible{outline:2px solid var(--ink,#173d34);outline-offset:3px}.ds-switch:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-switch:before,.ds-switch span{transition:none}}"
    },
    {
      "name": "Last saved receipt",
      "kind": "custom",
      "refersTo": "receipt",
      "description": "The saved state stays visible after motion ends; the timestamp and age are aligned evidence.",
      "html": "<div class=\"ds-receipt\"><span class=\"ds-receipt-icon\" aria-hidden=\"true\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><div class=\"ds-receipt-copy\"><p>Round 1 is saved.</p><p class=\"ds-receipt-detail\">Oct 20 · 5:27:26 PM</p></div><span class=\"ds-receipt-age\">just now</span></div>",
      "css": ".ds-receipt{min-height:83px;display:flex;align-items:center;gap:12px;padding:17px 7px 20px;border-top:1px solid var(--line,#3e6054);font-family:DM,sans-serif;color:var(--jasmine,#f6f3e8)}.ds-receipt-icon{display:flex;align-items:center;justify-content:center;flex:none;width:31px;height:31px;border:1px solid var(--brass,#e0bd7f);border-radius:50%;color:var(--brass,#e0bd7f)}.ds-receipt-icon .ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;width:17px;height:17px}.ds-receipt-copy{min-width:0;flex:1}.ds-receipt-copy p{font-size:14px;margin:0;line-height:1.45}.ds-receipt-copy .ds-receipt-detail{font-size:12px;color:var(--sage,#b8cbbd);margin-top:5px;font-variant-numeric:tabular-nums}.ds-receipt-age{font-size:12px;color:var(--brass,#e0bd7f);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}"
    },
    {
      "name": "108-bead progress",
      "kind": "custom",
